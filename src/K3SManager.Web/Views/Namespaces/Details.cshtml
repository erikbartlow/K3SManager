@model NamespaceDetailViewModel
@{
    var d = Model.Detail;
    var s = d.Summary;
    ViewData["Title"] = s.Name;
}

<div class="page-head">
    <div>
        <p class="eyebrow">Namespace</p>
        <h1>@s.Name</h1>
        <p>
            <span class="pill @ViewHelpers.PhaseClass(s.Phase)"><span class="pill__dot"></span>@s.Phase</span>
            &middot; created @ViewHelpers.Age(s.Age) ago
            &middot; @s.PodCount pod(s), @s.DeploymentCount deployment(s), @s.ServiceCount service(s)
        </p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--ghost" asp-action="Index">All namespaces</a>
    </div>
</div>

<div class="grid grid--stats" style="margin-bottom:16px">
    <div class="stat">
        <div class="stat__label">Pods running</div>
        <div class="stat__value">@s.PodsRunning<small> / @s.PodCount</small></div>
        <div class="stat__note">@s.PodsNotReady not ready</div>
    </div>
    <div class="stat">
        <div class="stat__label">CPU requested</div>
        <div class="stat__value">@ViewHelpers.Cores(s.CpuRequestedCores)</div>
    </div>
    <div class="stat">
        <div class="stat__label">Memory requested</div>
        <div class="stat__value">@ViewHelpers.GiB(s.MemoryRequestedGiB)</div>
    </div>
    <div class="stat">
        <div class="stat__label">Workloads</div>
        <div class="stat__value">@d.Workloads.Count</div>
        <div class="stat__note">@s.StatefulSetCount statefulset(s), @s.DaemonSetCount daemonset(s)</div>
    </div>
</div>

<section class="card" style="margin-bottom:16px">
    <div class="card__head"><h2>Workloads</h2></div>
    <div class="card__body card__body--flush table-wrap">
        @if (d.Workloads.Count == 0)
        {
            <div class="empty"><strong>Empty namespace</strong>Nothing is deployed here yet.</div>
        }
        else
        {
            <table class="data">
                <thead>
                    <tr><th>Kind</th><th>Name</th><th>Ready</th><th>Image</th><th class="num">Age</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var w in d.Workloads)
                {
                    <tr>
                        <td><span class="tag">@w.Kind</span></td>
                        <td class="mono">@w.Name</td>
                        <td><span class="pill @(w.IsHealthy ? "is-ok" : "is-warn")">@w.ReplicaLabel</span></td>
                        <td class="mono">@ViewHelpers.Clip(w.Images, 52)</td>
                        <td class="num mono">@ViewHelpers.Age(w.CreatedUtc is null ? null : DateTime.UtcNow - w.CreatedUtc)</td>
                        <td>
                            <div class="cell-actions">
                                @if (w.CanScale)
                                {
                                    <form admin-only method="post" asp-controller="Workloads" asp-action="Scale" style="display:flex;gap:4px">
                                        <input type="hidden" name="namespaceName" value="@s.Name" />
                                        <input type="hidden" name="name" value="@w.Name" />
                                        <input type="hidden" name="kind" value="@w.Kind" />
                                        <input type="number" name="replicas" min="0" max="500" value="@w.DesiredReplicas" style="width:72px" aria-label="Replicas for @w.Name" />
                                        <button class="btn btn--ghost btn--sm" type="submit">Scale</button>
                                    </form>
                                }
                                <form admin-only method="post" asp-controller="Workloads" asp-action="Restart">
                                    <input type="hidden" name="namespaceName" value="@s.Name" />
                                    <input type="hidden" name="name" value="@w.Name" />
                                    <input type="hidden" name="kind" value="@w.Kind" />
                                    <button class="btn btn--quiet btn--sm" type="submit">Restart</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</section>

<div class="grid grid--halves">
    <section class="card">
        <div class="card__head"><h2>Pods</h2></div>
        <div class="card__body card__body--flush table-wrap">
            @if (d.Pods.Count == 0)
            {
                <div class="empty"><strong>No pods</strong></div>
            }
            else
            {
                <table class="data">
                    <thead><tr><th>Name</th><th>Ready</th><th>Status</th><th>Node</th><th class="num">Restarts</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var p in d.Pods)
                    {
                        <tr>
                            <td class="mono">@p.Name</td>
                            <td><span class="pill @(p.IsReady ? "is-ok" : "is-warn")">@p.ContainerLabel</span></td>
                            <td><span class="pill @ViewHelpers.PhaseClass(p.Phase)">@p.Phase</span></td>
                            <td class="mono">
                                @if (!string.IsNullOrEmpty(p.NodeName))
                                {
                                    <a asp-controller="Nodes" asp-action="Details" asp-route-name="@p.NodeName">@p.NodeName</a>
                                }
                            </td>
                            <td class="num">@p.RestartCount</td>
                            <td>
                                <div class="cell-actions">
                                    <a class="btn btn--quiet btn--sm" target="_blank" rel="noopener"
                                       asp-controller="Workloads" asp-action="Logs"
                                       asp-route-namespaceName="@s.Name" asp-route-podName="@p.Name" asp-route-tailLines="400">Logs</a>
                                    <form admin-only method="post" asp-controller="Workloads" asp-action="DeletePod">
                                        <input type="hidden" name="namespaceName" value="@s.Name" />
                                        <input type="hidden" name="podName" value="@p.Name" />
                                        <button class="btn btn--quiet btn--sm" type="submit">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </section>

    <div class="stack">
        <section class="card">
            <div class="card__head"><h2>Services</h2></div>
            <div class="card__body card__body--flush table-wrap">
                @if (d.Services.Count == 0)
                {
                    <div class="empty"><strong>No services</strong></div>
                }
                else
                {
                    <table class="data">
                        <thead><tr><th>Name</th><th>Type</th><th>Cluster IP</th><th>Ports</th></tr></thead>
                        <tbody>
                        @foreach (var svc in d.Services)
                        {
                            <tr>
                                <td class="mono">@svc.Name</td>
                                <td><span class="tag">@svc.Type</span></td>
                                <td class="mono">@svc.ClusterIp</td>
                                <td class="mono">@svc.Ports</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </section>

        <section class="card">
            <div class="card__head"><h2>Resource quota</h2></div>
            <div class="card__body">
                @if (d.Quotas.Count > 0)
                {
                    foreach (var q in d.Quotas)
                    {
                        <p class="eyebrow">@q.Name</p>
                        <dl class="kv" style="margin-bottom:14px">
                            @foreach (var pair in q.Hard)
                            {
                                <dt class="mono">@pair.Key</dt>
                                <dd class="mono">@(q.Used.TryGetValue(pair.Key, out var used) ? used : "-") / @pair.Value</dd>
                            }
                        </dl>
                    }
                }

                <details class="disclosure">
                    <summary>Set a quota</summary>
                    <form admin-only method="post" asp-action="ApplyQuota" style="margin-top:10px">
                        <input type="hidden" name="NamespaceName" value="@s.Name" />
                        <div class="form-row">
                            <div class="field">
                                <label for="CpuRequests">CPU requests</label>
                                <input id="CpuRequests" name="CpuRequests" placeholder="2" autocomplete="off" />
                            </div>
                            <div class="field">
                                <label for="CpuLimits">CPU limits</label>
                                <input id="CpuLimits" name="CpuLimits" placeholder="4" autocomplete="off" />
                            </div>
                        </div>
                        <div class="form-row" style="margin-top:10px">
                            <div class="field">
                                <label for="MemoryRequests">Memory requests</label>
                                <input id="MemoryRequests" name="MemoryRequests" placeholder="4Gi" autocomplete="off" />
                            </div>
                            <div class="field">
                                <label for="MemoryLimits">Memory limits</label>
                                <input id="MemoryLimits" name="MemoryLimits" placeholder="8Gi" autocomplete="off" />
                            </div>
                            <div class="field">
                                <label for="PodLimit">Max pods</label>
                                <input id="PodLimit" name="PodLimit" type="number" min="0" />
                            </div>
                        </div>
                        <span class="hint">Quantities use Kubernetes notation: <code>2</code>, <code>500m</code>, <code>4Gi</code>.</span>
                        <button class="btn btn--ghost" type="submit" style="margin-top:12px">Apply quota</button>
                    </form>
                </details>
            </div>
        </section>

        <section class="card">
            <div class="card__head"><h2>Metadata</h2></div>
            <div class="card__body">
                @if (!Model.PersistenceEnabled)
                {
                    <p class="hint">A database connection is needed to store owner and description.</p>
                }
                else
                {
                    <form admin-only method="post" asp-action="SaveProfile">
                        <input type="hidden" name="NamespaceName" value="@s.Name" />
                        <div class="form-row">
                            <div class="field">
                                <label for="Owner">Owner</label>
                                <input id="Owner" name="Owner" value="@Model.Profile.Owner" autocomplete="off" />
                            </div>
                            <div class="field">
                                <label for="Environment">Environment</label>
                                <input id="Environment" name="Environment" value="@Model.Profile.Environment" autocomplete="off" />
                            </div>
                        </div>
                        <div class="field" style="margin-top:12px">
                            <label for="Description">Description</label>
                            <input id="Description" name="Description" value="@Model.Profile.Description" autocomplete="off" />
                        </div>
                        <label class="check">
                            <input name="IsPinned" type="checkbox" value="true" checked="@Model.Profile.IsPinned" />
                            Pin to the top of the list
                        </label>
                        <button class="btn btn--ghost" type="submit" style="margin-top:12px">Save metadata</button>
                    </form>
                }

                @if (s.Labels.Count > 0)
                {
                    <p class="eyebrow" style="margin-top:18px">Labels</p>
                    <div class="tag-row">
                        @foreach (var label in s.Labels)
                        {
                            <span class="tag">@label.Key=@label.Value</span>
                        }
                    </div>
                }
            </div>
        </section>
    </div>
</div>

@if (d.Events.Count > 0)
{
    <section class="card" style="margin-top:16px">
        <div class="card__head"><h2>Events</h2></div>
        <div class="card__body card__body--flush table-wrap">
            <table class="data">
                <thead><tr><th>Type</th><th>Object</th><th>Reason</th><th>Message</th><th class="num">Count</th></tr></thead>
                <tbody>
                @foreach (var e in d.Events)
                {
                    <tr>
                        <td><span class="pill @(e.Type == "Warning" ? "is-warn" : "is-ok")">@e.Type</span></td>
                        <td class="mono">@e.ObjectKind/@e.ObjectName</td>
                        <td>@e.Reason</td>
                        <td>@ViewHelpers.Clip(e.Message, 110)</td>
                        <td class="num">@e.Count</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

@if (!s.IsSystem)
{
    <section class="card danger-zone" style="margin-top:16px">
        <div class="card__head"><h2>Delete namespace</h2></div>
        <div class="card__body">
            @if (!Model.CanDelete)
            {
                <p class="hint">
                    Namespace deletion is switched off. Turn on <strong>Safety.AllowNamespaceDelete</strong> in Settings first.
                </p>
            }
            else
            {
                <p>
                    Deleting <strong>@s.Name</strong> removes every workload, service, secret and volume claim inside it.
                    This cannot be undone. Type the namespace name to confirm.
                </p>
                <form admin-only method="post" asp-action="Delete" data-confirm-name="@s.Name" class="form-row">
                    <input type="hidden" name="name" value="@s.Name" />
                    <div class="field">
                        <label for="confirmName">Namespace name</label>
                        <input id="confirmName" name="confirmName" autocomplete="off" placeholder="@s.Name" />
                    </div>
                    <button class="btn btn--danger" type="submit" disabled>Delete namespace</button>
                </form>
            }
        </div>
    </section>
}
